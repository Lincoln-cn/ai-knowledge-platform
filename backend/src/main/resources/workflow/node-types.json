  {
    "type": "IMAGE_GENERATE_NODE",
    "label": "图像生成",
    "description": "按提示词生成图片：图片存进文件存储，流程变量里留键与类型",
    "category": "多模态",
    "catalogEnabled": true,
    "executable": true,
    "outputs": [
      {
        "key": "image_key",
        "label": "图片文件键"
      },
      {
        "key": "image_mime",
        "label": "图片类型"
      }
    ],
    "configFields": [
      {
        "key": "modelId",
        "label": "模型",
        "type": "uuid",
        "required": true,
        "panelOnly": false,
        "optionsSource": "models",
        "modelKind": "IMAGE"
      },
      {
        "key": "promptKey",
        "label": "提示词变量",
        "type": "string",
        "required": false,
        "panelOnly": false,
        "hint": "读哪个流程变量拿到提示词，留空读 query"
      },
      {
        "key": "size",
        "label": "尺寸",
        "type": "string",
        "required": false,
        "panelOnly": false,
        "hint": "如 1024x1024；留空由上游决定"
      }
    ]
  }
]
