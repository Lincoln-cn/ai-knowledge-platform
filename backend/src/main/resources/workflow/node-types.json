      {
        "key": "basic_info_input",
        "label": "基本信息输入"
      }
    ]
  },
  {
    "type": "AI_CHAT_NODE",
    "label": "AI 对话",
    "description": "调用大模型生成回复，可带检索结果作为上下文",
