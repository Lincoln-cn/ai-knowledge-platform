    "catalogEnabled": true,
    "executable": true,
    "configFields": [
      {
        "key": "content",
        "label": "回复内容",
        "type": "string",
        "required": true,
        "panelOnly": false,
        "editor": "markdown",
        "default": "已为你整理如下："
      },
      {
        "key": "replyType",
        "label": "回复形态",
        "type": "string",
        "required": false,
        "panelOnly": false,
        "options": [
          "content"
