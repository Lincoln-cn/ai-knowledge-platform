    "catalogEnabled": false,
    "executable": false
  },
  {
    "type": "APPLICATION_NODE",
    "label": "应用调用",
    "description": "调用另一个已发布的编排应用",
    "category": "扩展",
    "catalogEnabled": false,
    "executable": false
  },
  {
    "type": "DOCUMENT_EXTRACT_NODE",
    "label": "文档抽取",
    "description": "把库里选定文档的正文抽出来交给下游",
    "category": "检索",
    "catalogEnabled": true,
    "executable": true,
    "configFields": [
      {
        "key": "kbId",
        "label": "知识库",
        "type": "uuid",
        "panelOnly": true,
        "required": false,
        "optionsSource": "knowledge-bases",
        "hint": "先选库才能选文档。这一项只给面板用，执行器不读"
      },
      {
        "key": "docId",
        "label": "文档",
        "type": "uuid",
        "required": true,
        "panelOnly": false,
        "optionsSource": "documents",
        "dependsOn": "kbId",
        "hint": "只有已解析出正文的文档能用；正文会写进流程变量 document_markdown"
      }
    ],
    "outputs": [
      "document_markdown"
    ]
  },
  {
    "type": "IMAGE_UNDERSTAND_NODE",
