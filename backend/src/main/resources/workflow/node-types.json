      {
        "key": "kbIds",
        "label": "知识库",
        "type": "string-list",
        "panelOnly": true,
        "required": false
      },
      {
        "key": "retrieval",
        "label": "检索参数",
        "type": "object",
        "panelOnly": true,
        "required": false
      },
      {
        "key": "thinkingEnabled",
        "label": "深度思考",
        "type": "boolean",
        "panelOnly": true,
        "required": false
      },
      {
        "key": "multiTurn",
        "label": "多轮对话",
