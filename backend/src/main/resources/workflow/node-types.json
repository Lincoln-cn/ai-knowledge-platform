        "type": "object",
        "required": false,
        "panelOnly": false
      }
    ],
    "outputs": [
      "retrieval_result"
    ]
  },
  {
    "type": "QUESTION_NODE",
    "label": "提问",
    "description": "向用户追问一个问题并把回答带回流程",
    "category": "交互",
    "catalogEnabled": true,
    "executable": true,
    "configFields": [
      {
        "key": "modelId",
        "label": "模型",
        "type": "uuid",
        "panelOnly": true,
        "required": false
      },
      {
        "key": "rewritePrompt",
        "label": "改写提示词",
        "type": "string",
        "panelOnly": true,
        "required": false
      },
      {
        "key": "defaultAnswer",
        "label": "默认答复",
        "type": "string",
        "required": false,
        "panelOnly": false
      }
    ],
    "outputs": [
      "query"
    ]
  },
  {
    "type": "CONDITION_NODE",
    "label": "条件判断",
    "description": "按条件把流程分成两支",
    "category": "逻辑",
    "catalogEnabled": true,
    "executable": true,
    "configFields": [
      {
        "key": "branches",
        "label": "分支",
        "type": "branch-list",
        "required": true,
        "panelOnly": false
      },
      {
        "key": "fallbackBranchId",
        "label": "兜底分支",
        "type": "string",
        "required": false,
        "panelOnly": false
      }
    ],
    "outputs": [
      "active_branch"
    ]
  },
  {
    "type": "NUMBER_CONDITION_NODE",
    "label": "数值条件",
    "description": "按数值比较把流程分成多支",
    "category": "逻辑",
    "catalogEnabled": true,
    "executable": true,
    "configFields": [
      {
        "key": "branches",
        "label": "分支",
        "type": "branch-list",
        "required": true,
        "panelOnly": false
      },
      {
        "key": "fallbackBranchId",
        "label": "兜底分支",
        "type": "string",
        "required": false,
        "panelOnly": false
      }
    ],
    "outputs": [
      "active_branch"
    ]
  },
  {
    "type": "REPLY_NODE",
    "label": "回复",
    "description": "直接输出一段固定文案",
    "category": "生成",
    "catalogEnabled": true,
    "executable": true,
    "configFields": [
      {
        "key": "content",
        "label": "回复内容",
        "type": "string",
        "required": true,
        "panelOnly": false,
        "editor": "markdown"
      },
      {
        "key": "replyType",
        "label": "回复形态",
        "type": "string",
        "required": false,
        "panelOnly": false,
        "options": [
          "content"
        ],
        "hint": "当前只有「自定义内容」一种。缺省即它，不必手选"
      },
      {
        "key": "asResult",
        "label": "返回内容",
        "type": "boolean",
        "required": false,
        "panelOnly": true,
        "hint": "打开后这条回复作为流程结果呈现给用户"
      }
    ],
    "outputs": [
      "reply"
    ]
  },
  {
    "type": "FUNCTION_LIB_NODE",
    "label": "函数库",
    "description": "调用预先登记的公共函数",
    "category": "扩展",
    "catalogEnabled": false,
    "executable": false
  },
  {
    "type": "FUNCTION_NODE",
    "label": "函数",
    "description": "在流程里直接写一段函数逻辑",
    "category": "扩展",
    "catalogEnabled": false,
    "executable": false
  },
  {
    "type": "RERANKER_NODE",
    "label": "重排",
    "description": "对检索结果重新排序",
