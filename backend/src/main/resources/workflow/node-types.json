        "key": "retrieval",
        "label": "检索参数",
        "type": "object",
        "required": false,
        "panelOnly": false,
        "default": {
          "mode": "HYBRID",
          "threshold": 0.6,
          "topN": 5,
          "noRefStrategy": "REFUSE"
        }
      }
    ],
    "outputs": [
      {
        "key": "retrieval_result",
        "label": "检索结果"
      }
    ]
