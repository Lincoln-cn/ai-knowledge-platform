    "catalogEnabled": true,
    "executable": true,
    "configFields": [
      {
        "key": "modelId",
        "label": "模型",
        "type": "uuid",
        "required": false,
        "panelOnly": false,
        "default": null
      },
      {
        "key": "rolePrompt",
        "label": "角色提示词",
        "type": "string",
        "panelOnly": true,
        "required": false,
        "default": ""
      },
      {
        "key": "promptIds",
        "label": "提示词模板",
        "type": "string-list",
        "panelOnly": true,
        "required": false,
        "default": []
      },
      {
        "key": "kbIds",
        "label": "知识库",
        "type": "string-list",
        "panelOnly": true,
        "required": false,
        "default": []
      },
      {
        "key": "retrieval",
        "label": "检索参数",
        "type": "object",
        "panelOnly": true,
        "required": false
      },
      {
        "key": "thinkingEnabled",
        "label": "深度思考",
        "type": "boolean",
        "panelOnly": true,
        "required": false,
        "default": false
      },
      {
        "key": "multiTurn",
        "label": "多轮对话",
        "type": "boolean",
        "panelOnly": true,
        "required": false,
        "default": false
      }
    ],
    "outputs": [
      {
        "key": "answer",
        "label": "AI 回答内容"
      }
    ]
  },
  {
    "type": "SEARCH_DATASET_NODE",
    "label": "知识库检索",
    "description": "在指定知识库里检索相关分段",
    "category": "检索",
    "catalogEnabled": true,
    "executable": true,
    "configFields": [
      {
        "key": "kbIds",
        "label": "知识库",
        "type": "string-list",
        "required": true,
        "panelOnly": false,
        "default": []
      },
      {
        "key": "retrieval",
        "label": "检索参数",
        "type": "object",
        "required": false,
        "panelOnly": false,
        "default": {
          "mode": "HYBRID",
          "threshold": 0.6,
          "topN": 5,
          "noRefStrategy": "REFUSE"
        }
      }
    ],
    "outputs": [
      {
        "key": "retrieval_result",
        "label": "检索结果"
      }
    ]
  },
  {
    "type": "QUESTION_NODE",
    "label": "提问",
    "description": "向用户追问一个问题并把回答带回流程",
    "category": "交互",
    "catalogEnabled": true,
    "executable": true,
    "configFields": [
      {
        "key": "modelId",
        "label": "模型",
        "type": "uuid",
        "panelOnly": true,
        "required": false
      },
      {
        "key": "rewritePrompt",
        "label": "改写提示词",
        "type": "string",
        "panelOnly": true,
        "required": false,
        "default": ""
      },
      {
        "key": "defaultAnswer",
        "label": "默认答复",
        "type": "string",
        "required": false,
        "panelOnly": false,
        "default": ""
      }
    ],
    "outputs": [
      {
        "key": "query",
        "label": "改写后的问题"
      }
    ]
  },
  {
    "type": "CONDITION_NODE",
    "label": "条件判断",
    "description": "按条件把流程分成两支",
    "category": "逻辑",
    "catalogEnabled": true,
    "executable": true,
    "configFields": [
      {
        "key": "branches",
        "label": "分支",
        "type": "branch-list",
        "required": true,
        "panelOnly": false,
        "default": [
          {
            "id": "branch-1",
            "type": "IF",
            "label": "条件 1",
            "expression": ""
          },
          {
            "id": "branch-2",
            "type": "ELSE",
            "label": "否则",
            "expression": ""
          }
        ]
      },
      {
        "key": "fallbackBranchId",
        "label": "兜底分支",
        "type": "string",
        "required": false,
        "panelOnly": false,
        "default": "branch-2"
      }
    ],
    "outputs": [
      {
        "key": "active_branch",
        "label": "命中的分支"
      }
    ]
  },
  {
    "type": "NUMBER_CONDITION_NODE",
    "label": "数值条件",
    "description": "按数值比较把流程分成多支",
    "category": "逻辑",
    "catalogEnabled": true,
    "executable": true,
    "configFields": [
      {
        "key": "branches",
        "label": "分支",
        "type": "branch-list",
        "required": true,
        "panelOnly": false,
        "default": [
          {
            "id": "branch-1",
            "type": "IF",
            "label": "条件 1",
            "conditions": []
          },
          {
            "id": "branch-2",
            "type": "ELSE",
            "label": "否则",
            "conditions": []
          }
        ]
      },
      {
        "key": "fallbackBranchId",
        "label": "兜底分支",
        "type": "string",
        "required": false,
        "panelOnly": false,
        "default": "branch-2"
      }
    ],
    "outputs": [
      {
        "key": "active_branch",
        "label": "命中的分支"
      }
    ]
  },
  {
    "type": "REPLY_NODE",
    "label": "回复",
    "description": "直接输出一段固定文案",
    "category": "生成",
    "catalogEnabled": true,
    "executable": true,
    "configFields": [
      {
        "key": "content",
        "label": "回复内容",
        "type": "string",
        "required": true,
        "panelOnly": false,
        "editor": "markdown",
        "default": "已为你整理如下："
      },
      {
        "key": "replyType",
        "label": "回复形态",
        "type": "string",
        "required": false,
        "panelOnly": false,
        "options": [
          "content"
        ],
        "hint": "当前只有「自定义内容」一种。缺省即它，不必手选",
        "default": "content"
      },
      {
        "key": "asResult",
        "label": "返回内容",
        "type": "boolean",
        "required": false,
        "panelOnly": true,
        "hint": "打开后这条回复作为流程结果呈现给用户",
        "default": true
      }
    ],
    "outputs": [
      {
        "key": "reply",
        "label": "回复内容"
      }
    ]
  },
  {
    "type": "FUNCTION_LIB_NODE",
    "label": "函数库",
    "description": "调用平台内置的公共函数（不是执行自定义脚本 —— 沙箱在 0.9.0），结果写进流程变量",
    "category": "扩展",
    "catalogEnabled": true,
    "executable": true,
    "configFields": [
      {
        "key": "functionName",
        "label": "函数",
        "type": "string",
        "required": true,
        "panelOnly": false,
        "hint": "内置函数：upper / lower / trim / length / concat / substring / replace / split / join / default / jsonpath"
      },
      {
        "key": "args",
        "label": "参数",
        "type": "object-list",
        "required": false,
        "panelOnly": true,
        "hint": "每条参数选「字面量」或「流程变量」；省略来源时按字面量"
      },
      {
        "key": "outputKey",
        "label": "输出到变量",
        "type": "string",
        "required": false,
        "panelOnly": true,
        "default": "function_result"
      }
    ],
    "outputs": [
      {
        "key": "function_result",
        "label": "函数结果"
      }
    ]
  },
  {
    "type": "FUNCTION_NODE",
    "label": "函数",
    "description": "直接指定内置函数名调一次（不执行自定义脚本 —— 沙箱在 0.9.0），结果写进流程变量",
    "category": "扩展",
    "catalogEnabled": true,
    "executable": true,
    "configFields": [
      {
        "key": "functionName",
        "label": "函数",
        "type": "string",
        "required": true,
        "panelOnly": false,
        "hint": "内置函数：upper / lower / trim / length / concat / substring / replace / split / join / default / jsonpath"
      },
      {
        "key": "args",
        "label": "参数",
        "type": "object-list",
        "required": false,
        "panelOnly": true,
        "hint": "每条参数选「字面量」或「流程变量」；省略来源时按字面量"
      },
      {
        "key": "outputKey",
        "label": "输出到变量",
        "type": "string",
        "required": false,
        "panelOnly": true,
        "default": "function_result"
      }
    ],
    "outputs": [
      {
        "key": "function_result",
        "label": "函数结果"
      }
    ]
  },
  {
    "type": "RERANKER_NODE",
    "label": "重排",
    "description": "把上游检索到的候选按与问题的相关性重新排序",
    "category": "检索",
    "catalogEnabled": true,
    "executable": true,
    "configFields": [
      {
        "key": "topK",
        "label": "重排前几名",
        "type": "number",
        "required": false,
        "panelOnly": false,
        "default": 5,
        "hint": "只重排前几名，其余保持原序。实测重排前 5 个 +10.3 点引用准确率，全量反而更慢"
      },
      {
        "key": "question",
        "label": "用来比对的问题",
        "type": "string",
        "required": false,
        "panelOnly": false,
        "default": "",
        "hint": "留空则用流程变量 query（上游问题改写节点的输出）"
      }
    ],
    "outputs": [
      {
        "key": "rerank_result",
        "label": "重排后的资料"
      },
      {
        "key": "rerank_hits",
        "label": "重排后的命中明细"
      }
    ]
  },
  {
    "type": "APPLICATION_NODE",
    "label": "应用调用",
    "description": "把一个已发布的编排应用当成这一步的函数：用上游输入跑它，拿它的最终输出",
    "category": "扩展",
    "catalogEnabled": true,
    "executable": true,
    "configFields": [
      {
        "key": "applicationId",
        "label": "被调应用",
        "type": "uuid",
        "required": true,
        "panelOnly": false
      },
      {
        "key": "version",
        "label": "版本",
        "type": "string",
        "required": false,
        "panelOnly": false,
        "hint": "留空 = 最新已发布版本；也可以填版本号或版本主键"
      }
    ],
    "outputs": [
      {
        "key": "app_output",
        "label": "被调应用的输出"
      }
    ]
  },
  {
    "type": "DOCUMENT_EXTRACT_NODE",
    "label": "文档抽取",
    "description": "把库里选定文档的正文抽出来交给下游",
    "category": "检索",
    "catalogEnabled": true,
    "executable": true,
    "configFields": [
      {
        "key": "kbId",
        "label": "知识库",
        "type": "uuid",
        "panelOnly": true,
        "required": false,
        "optionsSource": "knowledge-bases",
        "hint": "先选库才能选文档。这一项只给面板用，执行器不读",
        "default": null
      },
      {
        "key": "docId",
        "label": "文档",
        "type": "uuid",
        "required": true,
        "panelOnly": false,
        "optionsSource": "documents",
        "dependsOn": "kbId",
        "hint": "只有已解析出正文的文档能用；正文会写进流程变量 document_markdown",
        "default": null
      }
    ],
    "outputs": [
      {
        "key": "document_markdown",
        "label": "文档正文"
      }
    ]
  },
  {
    "type": "IMAGE_UNDERSTAND_NODE",
    "label": "图像理解",
    "description": "用对话模型看一张图，回答关于它的问题",
    "category": "多模态",
    "catalogEnabled": true,
    "executable": true,
    "outputs": [
      {
        "key": "image_description",
        "label": "图片描述"
      }
    ],
    "configFields": [
      {
        "key": "modelId",
        "label": "模型",
        "type": "uuid",
        "required": true,
        "panelOnly": false,
        "hint": "选一个对话模型 —— 视觉输入是对话协议的扩展，不是另一种模型种类",
        "optionsSource": "models",
        "modelKind": "CHAT"
      },
      {
        "key": "question",
        "label": "问题",
        "type": "string",
        "required": false,
        "panelOnly": false,
        "hint": "留空就问「请客观描述这张图片的内容。」"
      },
      {
        "key": "imageKey",
        "label": "图片变量",
        "type": "string",
        "required": false,
        "panelOnly": false,
        "hint": "读哪个流程变量拿到图片键，留空读 image_key"
      }
    ]
  },
  {
    "type": "FORM_NODE",
    "label": "表单收集",
    "description": "向用户收集多个字段",
    "category": "交互",
    "catalogEnabled": true,
    "executable": true,
    "configFields": [
      {
        "key": "formFields",
        "label": "收集字段",
        "type": "object-list",
        "required": false,
        "panelOnly": true,
        "default": []
      },
      {
        "key": "contentFormat",
        "label": "引导文案",
        "type": "string",
        "required": false,
        "panelOnly": true,
        "default": "你好，请先填写下面表单内容：\n{{form}}\n填写后请点击【提交】按钮进行提交。"
      },
      {
        "key": "asResult",
        "label": "提交即结束",
        "type": "boolean",
        "required": false,
        "panelOnly": true,
        "default": true
      }
    ],
    "outputs": [
      {
        "key": "form_data",
        "label": "表单内容"
      }
    ]
  },
  {
    "type": "TEXT_TO_SPEECH_NODE",
    "label": "语音合成",
    "description": "把一段文字念成音频：音频存进文件存储，流程变量里只留键",
    "category": "多模态",
    "catalogEnabled": true,
    "executable": true,
    "outputs": [
      {
        "key": "audio_key",
        "label": "音频文件键"
      },
      {
        "key": "audio_format",
        "label": "音频格式"
      }
    ],
    "configFields": [
      {
        "key": "modelId",
        "label": "模型",
        "type": "uuid",
        "required": true,
        "panelOnly": false,
        "optionsSource": "models",
        "modelKind": "TTS"
      },
      {
        "key": "voice",
        "label": "音色",
        "type": "string",
        "required": true,
        "panelOnly": false,
        "hint": "各上游取值不同，如 alloy / nova / zh-CN-XiaoxiaoNeural"
      },
      {
        "key": "sourceKey",
        "label": "文本变量",
        "type": "string",
        "required": false,
        "panelOnly": false,
        "hint": "读哪个流程变量拿到要念的文字，留空读 answer"
      }
    ]
  },
  {
    "type": "SPEECH_TO_TEXT_NODE",
    "label": "语音识别",
    "description": "把音频转成文字：读音频键，写识别出的文本",
    "category": "多模态",
    "catalogEnabled": true,
    "executable": true,
    "outputs": [
      {
        "key": "speech_transcript",
        "label": "识别文本"
      }
    ],
    "configFields": [
      {
        "key": "modelId",
        "label": "模型",
        "type": "uuid",
        "required": true,
        "panelOnly": false,
        "optionsSource": "models",
        "modelKind": "STT"
      },
      {
        "key": "audioKey",
        "label": "音频变量",
        "type": "string",
        "required": false,
        "panelOnly": false,
        "hint": "读哪个流程变量拿到音频键，留空读 audio_key（与语音合成节点的产出一致）"
