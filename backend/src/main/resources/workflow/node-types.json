    "catalogEnabled": true,
    "executable": true,
    "configFields": [],
    "outputs": [
      {
        "key": "query",
        "label": "用户问题"
      }
    ]
  },
  {
    "type": "BASE_NODE",
    "label": "基础节点",
    "description": "只做数据传递的占位节点，用于整理连线",
    "category": "基础",
    "catalogEnabled": true,
    "executable": true,
    "configFields": [
      {
        "key": "fields",
        "label": "收集字段",
        "type": "object-list",
        "required": false,
        "panelOnly": false,
        "default": []
