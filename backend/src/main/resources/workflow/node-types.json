        "panelOnly": false,
        "default": [
          {
            "id": "branch-1",
            "type": "IF",
            "label": "条件 1",
            "expression": ""
          },
          {
            "id": "branch-2",
            "type": "ELSE",
            "label": "否则",
            "expression": ""
          }
        ]
      },
      {
        "key": "fallbackBranchId",
        "label": "兜底分支",
        "type": "string",
        "required": false,
        "panelOnly": false,
        "default": "branch-2"
      }
    ],
    "outputs": [
      {
        "key": "active_branch",
        "label": "命中的分支"
      }
    ]
  },
  {
    "type": "NUMBER_CONDITION_NODE",
    "label": "数值条件",
    "description": "按数值比较把流程分成多支",
    "category": "逻辑",
    "catalogEnabled": true,
    "executable": true,
    "configFields": [
      {
        "key": "branches",
        "label": "分支",
        "type": "branch-list",
