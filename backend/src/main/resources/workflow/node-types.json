      {
        "key": "prologue",
        "label": "开场白",
        "type": "string",
        "required": false,
        "panelOnly": true
      },
      {
        "key": "apiFields",
        "label": "接口传参",
        "type": "object-list",
        "required": false,
        "panelOnly": true,
        "default": []
      }
    ],
    "outputs": [
      {
        "key": "basic_info_fields",
        "label": "基本信息字段"
